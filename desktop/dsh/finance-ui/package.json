{
  "name": "vibe-finance-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./server.mjs",
  "exports": {
    ".": "./server.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-input-trigger"]
    }
  }
}
