+/** Normalize library patch offsets against packed bytes; leave the published Web patch intact. */
+import { createHash } from 'node:crypto'
+import { execFileSync, spawnSync } from 'node:child_process'
+import { cpSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
+import { join, relative, resolve } from 'node:path'
+import { resolveDesktopTargetBuildPaths } from './desktop-build-paths.mjs'
+
+const root = resolve(import.meta.dirname, '../../..')
+const paths = resolveDesktopTargetBuildPaths()
+const products = join(paths.root, 'products')
+const directory = join(products, 'patches')
+const records = []
+const hash = bytes => createHash('sha256').update(bytes).digest('hex')
+const operations = patch => patch.split('\n')
+  .filter(line => /^[+-]/u.test(line) && !line.startsWith('+++') && !line.startsWith('---')).join('\n')
+for (const file of readdirSync(directory).filter(name => name.endsWith('.patch')).sort()) {
+  const patch = join(directory, file)
+  const original = readFileSync(join(products, 'vibe/desktop/dsh/runtime/patches', file), 'utf8')
+    .replaceAll(/([ab])\/node_modules\/@deepseek-ai\/[^/]+\//g, '$1/')
+  if (file.includes('+dsh-web-frontend+')) {
+    if (readFileSync(patch, 'utf8') !== original) throw new Error('product patches: released Web patch bytes changed')
+    records.push({ file, original: hash(original), prepared: hash(original), offsetsNormalized: false })
+    continue
+  }
+  const name = file.split('+')[1]
+  const probe = join(products, 'patch-probes', name)
+  rmSync(probe, { recursive: true, force: true })
+  mkdirSync(probe, { recursive: true })
+  execFileSync('tar', ['-xzf', join(paths.packedDsh, `deepseek-ai-${name}-0.2.1-rc.2.tgz`), '-C', probe])
+  const before = join(probe, 'package')
+  const after = join(probe, 'after')
+  cpSync(before, after, { recursive: true })
+  execFileSync('git', ['apply', `--directory=${relative(root, after)}`, '-'], { cwd: root, input: original })
+  const result = spawnSync('git', ['diff', '--no-index', '--', before, after], { cwd: probe, encoding: 'utf8' })
+  if (result.status !== 1) throw new Error(`product patches: expected a changed artifact for ${name}: ${result.stderr}`)
+  const normalized = result.stdout
+    .replaceAll(`a${before}/`, 'a/').replaceAll(`b${after}/`, 'b/')
+  if (operations(original) !== operations(normalized)) throw new Error(`product patches: changed operations for ${name}`)
+  writeFileSync(patch, normalized)
+  records.push({ file, original: hash(original), prepared: hash(normalized), offsetsNormalized: true })
+}
+writeFileSync(join(products, 'patch-receipt.json'), `${JSON.stringify(records, null, 2)}\n`)
+console.log(`product patches: ${records.filter(record => record.offsetsNormalized).length} library offsets normalized; released Web patch unchanged`)
