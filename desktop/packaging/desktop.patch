+  for (const field of ['iconMac', 'iconWindows', 'trayWindows']) {
+    const icon = isAbsolute(brand[field]) ? brand[field] : join(appRoot, brand[field])
+    if (!existsSync(icon)) throw new Error(`desktop branding: ${field} does not exist: ${icon}`)
+    brand[field] = icon
+  }
+  return { ...brand, source: 'file', file: path }
+}
+
+/**
+ * Replace the upstream product name in one dictionary. Model-provider wording is left alone.
+ * @param {Record<string, string>} messages - Locale dictionary.
+ * @param {{ brandEn: string, brandZh: string }} brand - Resolved product names.
+ * @param {'en' | 'zh-CN'} locale - Dictionary language.
+ * @returns {Record<string, string>} Dictionary with the product name replaced.
+ */
+export function applyDesktopBrandMessages(messages, brand, locale) {
+  const replacement = locale === 'zh-CN' ? brand.brandZh : brand.brandEn
+  if (replacement === 'DeepSeek Harness') return messages
+  return Object.fromEntries(Object.entries(messages).map(([key, value]) => [key, value.replaceAll('DeepSeek Harness', replacement)]))
+}
+
+/** Resolve the same update feed for builder metadata, artifact verification, and the release record. */
+export function resolveBrandedDesktopUpdateConfig(env, platform, arch) {
+  const brand = loadDesktopBrand(env)
+  if (brand.source === 'default') return resolveDesktopAutoUpdateConfig(env, platform, arch)
+  // Upstream owns channel, release ID, feed and binary prefixes in both deployments.
+  const update = resolveDesktopAutoUpdateConfig({ ...env,
+    DSH_DESKTOP_UPDATE_CHANNEL: env.DSH_DESKTOP_UPDATE_CHANNEL || brand.updateChannel,
+    DOWNLOAD_TEST_ORIGIN: new URL(brand.updateOrigin).origin,
+  }, platform, arch)
+  return {
+    ...update,
+    origin: brand.updateOrigin,
+    publicUrl: `${brand.updateOrigin}/${update.keyPrefix}/`,
+  }
+}
+
+/** Name one artifact consistently in electron-builder and the completed-payload collector. */
+export function desktopArtifactBase(brand, version, os, arch, unsigned = false) {
+  return `${brand.source === 'file' ? brand.productName : 'deepseek-harness'}-${version}-${os}-${arch}${unsigned ? '-unsigned' : ''}`
+}
