diff --git a/apps/desktop/tests/desktop-branding.spec.ts b/apps/desktop/tests/desktop-branding.spec.ts
new file mode 100644
index 0000000000..dee1aafcdd
--- /dev/null
+++ b/apps/desktop/tests/desktop-branding.spec.ts
@@ -0,0 +1,131 @@
+/** Product overlay stays optional and feeds the package identity, protocol, and update base. */
+
+import { mkdtempSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { expect, it } from 'vitest'
+import { applyDesktopBrandMessages, loadDesktopBrand, resolveBrandedDesktopStorage } from '../src/branding.ts'
+import { loadDesktopBrand as loadBuildBrand, resolveBrandedDesktopUpdateConfig } from '../scripts/desktop-branding.mjs'
+import { resolveDesktopAutoUpdateConfig } from '../scripts/desktop-auto-update-environment.mjs'
+
+const SAMPLE = fileURLToPath(new URL('../branding.vibe-finance.json', import.meta.url))
+
+it('gives a product appId private Harness and Electron roots without changing upstream storage', () => {
+  expect(resolveBrandedDesktopStorage({ appId: 'com.deepseek.harness' }, '/home/test')).toBeUndefined()
+  expect(resolveBrandedDesktopStorage({ appId: 'com.vibefinance.desktop' }, '/home/test')).toEqual({
+    dshHome: '/home/test/.dsh-products/com.vibefinance.desktop',
+    userData: '/home/test/.dsh-products/com.vibefinance.desktop/desktop-user-data',
+  })
+})
+
+it('keeps the upstream identity when no branding file is provided', () => {
+  const runtime = loadDesktopBrand({})
+  const build = loadBuildBrand({})
+  expect(runtime.source).toBe('default')
+  expect(build.source).toBe('default')
+  expect(runtime.productName).toBe('DeepSeek Harness')
+  expect(runtime.protocol).toBe('dsh')
+  expect(runtime.updateOrigin).toBe('https://download.deepseek.com')
+  expect(build).toMatchObject({ productName: 'DeepSeek Harness', protocol: 'dsh', updateChannel: 'nightly' })
+})
+
+it('reads the Vibe Finance sample without changing model-provider wording', () => {
+  const brand = loadDesktopBrand({ DSH_DESKTOP_BRANDING: SAMPLE })
+  expect(brand).toMatchObject({
+    source: 'file',
+    productName: 'Vibe Finance',
+    appId: 'com.vibefinance.desktop',
+    protocol: 'vibefinance',
+    updateOrigin: 'https://updates.example.invalid/vibe',
+    updateChannel: 'nightly',
+  })
+  expect(brand.iconMac).toMatch(/icon-mac\.png$/u)
+  expect(brand.iconWindows).toMatch(/icon-windows\.png$/u)
+  expect(brand.trayWindows).toMatch(/tray-windows\.ico$/u)
+  const messages = applyDesktopBrandMessages({
+    about: 'About DeepSeek Harness',
+    model: 'Configure official DeepSeek models',
+  }, brand, 'en')
+  expect(messages.about).toBe('About Vibe Finance')
+  expect(messages.model).toBe('Configure official DeepSeek models')
+})
+
+it('rejects a non-HTTPS update origin', () => {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-brand-'))
+  const path = join(root, 'branding.json')
+  writeFileSync(path, JSON.stringify({ updateOrigin: 'http://updates.example.invalid/vibe' }))
+  expect(() => loadDesktopBrand({ DSH_DESKTOP_BRANDING: path })).toThrow(/HTTPS/u)
+})
+
+it('shares the brand feed with artifact verification and release metadata', () => {
+  expect(resolveBrandedDesktopUpdateConfig({ DSH_DESKTOP_BRANDING: SAMPLE, DSH_DESKTOP_AUTO_UPDATE_ENV: 'production' }, 'darwin', 'arm64')).toMatchObject({
+    environment: 'production', target: 'mac-arm64', channel: 'nightly',
+    origin: 'https://updates.example.invalid/vibe',
+    publicUrl: 'https://updates.example.invalid/vibe/dsh-desk/feeds/mac-arm64/',
+  })
+})
+
+it.each(['test', 'production'] as const)('preserves rc.2 feed and binary paths in %s for both channels', environment => {
+  for (const channel of ['nightly', 'latest']) {
+    const update = resolveBrandedDesktopUpdateConfig({
+      DSH_DESKTOP_BRANDING: SAMPLE,
+      DSH_DESKTOP_AUTO_UPDATE_ENV: environment,
+      DSH_DESKTOP_UPDATE_CHANNEL: channel,
+      DOWNLOAD_TEST_RELEASE_ID: 'a'.repeat(32),
+    }, 'darwin', 'arm64')
+    const prefix = `dsh-desk${environment === 'test' ? `/${'a'.repeat(32)}` : ''}`
+    expect(update).toMatchObject({ environment, channel,
+      keyPrefix: `${prefix}/feeds/mac-arm64`,
+      binaryKeyPrefix: `${prefix}/bin/mac-arm64${channel === 'latest' ? '/latest' : ''}`,
+      publicUrl: `https://updates.example.invalid/vibe/${prefix}/feeds/mac-arm64/`,
+    })
+  }
+})
+
+it('retains the rc.2 test release ID requirement with a brand origin', () => {
+  expect(() => resolveBrandedDesktopUpdateConfig({ DSH_DESKTOP_BRANDING: SAMPLE }, 'darwin', 'arm64'))
+    .toThrow(/DOWNLOAD_TEST_RELEASE_ID/u)
+})
+
+it('leaves unbranded rc.2 update resolution unchanged', () => {
+  const environment = { DSH_DESKTOP_AUTO_UPDATE_ENV: 'test', DSH_DESKTOP_UPDATE_CHANNEL: 'latest',
+    DOWNLOAD_TEST_ORIGIN: 'https://upstream.example.com', DOWNLOAD_TEST_RELEASE_ID: 'b'.repeat(32) }
+  expect(resolveBrandedDesktopUpdateConfig(environment, 'darwin', 'arm64'))
+    .toEqual(resolveDesktopAutoUpdateConfig(environment, 'darwin', 'arm64'))
+})
+
+it('uses branded Windows icons and artifact names without enabling unsigned updates', async () => {
+  const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+  const config = createElectronBuilderConfig({
+    DSH_DESKTOP_APP_ID: 'com.deepseek.harness',
+    DSH_DESKTOP_UNSIGNED: '1',
+    DSH_DESKTOP_BRANDING: SAMPLE,
+    DSH_DESKTOP_TARGET_PLATFORM: 'win32',
+    DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN: 'https://policy.example.com',
+    DSH_DESKTOP_MANDATORY_UPDATE_CONFIG: JSON.stringify({ allowedAuthOrigins: ['https://login.example.com'] }),
+  }, 'win32', 'x64')
+  expect(config.productName).toBe('Vibe Finance')
+  expect(config.appId).toBe('com.vibefinance.desktop')
+  expect(config.protocols).toEqual([{ name: 'Vibe Finance', schemes: ['vibefinance'] }])
+  expect(config.win.icon).toMatch(/icon-windows\.png$/u)
+  expect(config.extraResources).toEqual(expect.arrayContaining([
+    expect.objectContaining({ to: 'icon.png', from: expect.stringMatching(/icon-windows\.png$/u) }),
+    expect.objectContaining({ to: 'tray.ico', from: expect.stringMatching(/tray-windows\.ico$/u) }),
+    expect.objectContaining({ to: 'branding.json' }),
+  ]))
+  expect(config.publish).toBeNull()
+  expect(config.artifactName).toBe('Vibe Finance-${version}-${os}-${arch}-unsigned.${ext}')
+})
+
+it('leaves an unbranded unsigned package on the upstream name and without an update feed', async () => {
+  const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+  const config = createElectronBuilderConfig({
+    DSH_DESKTOP_APP_ID: 'com.example.desktop',
+    DSH_DESKTOP_UNSIGNED: '1',
+  }, 'darwin', 'arm64')
+  expect(config.productName).toBe('DeepSeek Harness')
+  expect(config.appId).toBe('com.example.desktop')
+  expect(config.protocols).toEqual([{ name: 'DeepSeek Harness', schemes: ['dsh'] }])
+  expect(config.publish).toBeNull()
+})
