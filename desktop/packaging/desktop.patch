+body[data-vibe-finance] #entry-actions { width: 280px; }
+body[data-vibe-finance] .actions .text-link {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  height: 28px;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+  font-size: 14px;
+  font-family: inherit;
+  line-height: 24px;
+  app-region: no-drag;
+  cursor: pointer;
+  text-decoration: underline;
+}
+body[data-vibe-finance] .key-heading p { max-width: 380px; line-height: 24px; }
