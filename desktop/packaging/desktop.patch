+const environment = { PATH: process.env.PATH, HOME: join(stage, 'home'), TMPDIR: process.env.TMPDIR ?? '/tmp',
+  CI: '1', LANG: process.env.LANG ?? 'C',
+  npm_config_userconfig: join(config, 'npm-user.conf'), npm_config_globalconfig: join(config, 'npm-global.conf'),
