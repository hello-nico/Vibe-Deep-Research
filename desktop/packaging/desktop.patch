diff --git a/apps/desktop/scripts/build-product-runtime.ts b/apps/desktop/scripts/build-product-runtime.ts
new file mode 100644
index 0000000000..c25d8db4a4
--- /dev/null
+++ b/apps/desktop/scripts/build-product-runtime.ts
@@ -0,0 +1,32 @@
+/** Build Host and client libraries while using the released Web shell verbatim. */
+import { execFileSync } from 'node:child_process'
+import { cpSync, mkdirSync, rmSync } from 'node:fs'
+import { join, resolve } from 'node:path'
+import {
+  clientBuildProcessEnvironment,
+  repositoryClientBuildEnvironment,
+  resolveClientBuildEnvironment,
+  writeClientBuildRecord,
+} from '../../../scripts/client-build-environment.ts'
+import { pnpmInvocation } from '../../../scripts/pnpm-invocation.ts'
+import { libraryBuildSteps } from '../../../scripts/compile-referenced-projects.ts'
+import { resolveDesktopTargetBuildPaths } from './desktop-build-paths.mjs'
+
+const root = resolve(import.meta.dirname, '../../..')
+const client = resolveClientBuildEnvironment(repositoryClientBuildEnvironment(root, process.env), 'official')
+const environment = clientBuildProcessEnvironment(process.env, client)
+const native = pnpmInvocation(['run', 'build:native-system'], environment)
+execFileSync(native.command, native.args, { cwd: root, env: environment, stdio: 'inherit' })
+for (const step of libraryBuildSteps(root, 'all')) {
+  execFileSync(step.command, step.args, { cwd: root, env: environment, stdio: 'inherit' })
+}
+const stage = join(resolveDesktopTargetBuildPaths().root, 'published-web')
+mkdirSync(stage, { recursive: true })
+execFileSync('npm', ['pack', '@deepseek-ai/dsh-web-frontend@0.2.1-rc.2', '--ignore-scripts',
+  '--cache', join(stage, 'cache'), '--pack-destination', stage], { cwd: root, env: environment, stdio: 'inherit' })
+execFileSync('tar', ['-xzf', join(stage, 'deepseek-ai-dsh-web-frontend-0.2.1-rc.2.tgz'), '-C', stage], { cwd: root })
+const destination = join(root, 'apps/web/dist')
+rmSync(destination, { recursive: true, force: true })
+cpSync(join(stage, 'package/dist'), destination, { recursive: true })
+writeClientBuildRecord(root, client)
+console.log('desktop product runtime: released Web shell staged without a Web source build')
diff --git a/apps/desktop/scripts/desktop-branding.d.mts b/apps/desktop/scripts/desktop-branding.d.mts
new file mode 100644
index 0000000000..4774f2c632
--- /dev/null
+++ b/apps/desktop/scripts/desktop-branding.d.mts
@@ -0,0 +1,16 @@
+export interface DesktopBrandFile {
+  readonly source: 'default' | 'file'
+  readonly productName: string
+  readonly protocol: string
+  readonly updateOrigin: string
+  readonly updateChannel: string
+}
+
+export function loadDesktopBrand(env?: NodeJS.ProcessEnv, appRoot?: string): DesktopBrandFile
+
+/** Shared feed selection for packaging, verification, and release metadata. */
+export function resolveBrandedDesktopUpdateConfig(env: NodeJS.ProcessEnv, platform: NodeJS.Platform, arch: string):
+  import('./desktop-auto-update-environment.mjs').DesktopAutoUpdateConfig
+
+/** Artifact basename without its file extension. */
+export function desktopArtifactBase(brand: Pick<DesktopBrandFile, 'source' | 'productName'>, version: string, os: string, arch: string, unsigned?: boolean): string
diff --git a/apps/desktop/scripts/desktop-branding.mjs b/apps/desktop/scripts/desktop-branding.mjs
new file mode 100644
index 0000000000..174674f320
--- /dev/null
+++ b/apps/desktop/scripts/desktop-branding.mjs
@@ -0,0 +1,128 @@
+/** Optional product overlay. Missing config keeps the upstream Desktop identity. */
+
+import { existsSync, readFileSync } from 'node:fs'
+import { isAbsolute, join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { resolveDesktopAutoUpdateConfig } from './desktop-auto-update-environment.mjs'
+
+export const DESKTOP_APP_ROOT = fileURLToPath(new URL('..', import.meta.url))
+
+export const UPSTREAM_DESKTOP_BRAND = {
+  productName: 'DeepSeek Harness',
+  appId: 'com.deepseek.harness',
+  protocol: 'dsh',
+  iconMac: 'resources/icon-macos.png',
+  iconWindows: 'resources/icon-windows.png',
+  trayWindows: 'resources/tray-windows.ico',
+  updateOrigin: 'https://download.deepseek.com',
+  updateChannel: 'nightly',
+  brandEn: 'DeepSeek Harness',
+  brandZh: 'DeepSeek Harness',
+}
+
+const BRAND_FIELDS = Object.keys(UPSTREAM_DESKTOP_BRAND)
+
+/**
+ * Locate an explicit branding file. Absence is the upstream default, not an error.
+ * @param {NodeJS.ProcessEnv} env - Packaging or runtime environment.
+ * @param {string} appRoot - Desktop application directory.
+ * @returns {string | undefined} Absolute config path.
+ */
+export function resolveDesktopBrandingPath(env = process.env, appRoot = DESKTOP_APP_ROOT) {
+  const fromEnv = env.DSH_DESKTOP_BRANDING
+  if (fromEnv !== undefined && fromEnv !== '') return resolve(fromEnv)
+  const local = join(appRoot, 'branding.json')
+  if (existsSync(local)) return local
+  const resources = env.DSH_DESKTOP_RESOURCES || process.resourcesPath
+  if (resources !== undefined && resources !== '' && existsSync(join(resources, 'branding.json'))) return join(resources, 'branding.json')
