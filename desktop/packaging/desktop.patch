+}
+body[data-vibe-finance] .vibe-brand {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  font-size: 24px;
+  font-weight: 600;
+}
+.vibe-brand svg { width: 40px; height: 40px; color: hsl(17 78% 51%); }
+body[data-vibe-finance] .tagline { color: #62656b; font-weight: 400; }
