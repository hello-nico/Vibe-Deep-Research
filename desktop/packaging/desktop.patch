diff --git a/apps/desktop/src/branding.ts b/apps/desktop/src/branding.ts
new file mode 100644
index 0000000000..e2666f8307
--- /dev/null
+++ b/apps/desktop/src/branding.ts
@@ -0,0 +1,112 @@
+/** Runtime view of the optional product overlay. No file keeps the upstream identity. */
+
+import { existsSync, readFileSync } from 'node:fs'
+import { isAbsolute, join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { homedir } from 'node:os'
+
+export const DESKTOP_APP_ROOT = fileURLToPath(new URL('..', import.meta.url))
+
+export const UPSTREAM_DESKTOP_BRAND = {
+  productName: 'DeepSeek Harness',
+  appId: 'com.deepseek.harness',
+  protocol: 'dsh',
+  iconMac: 'resources/icon-macos.png',
+  iconWindows: 'resources/icon-windows.png',
+  trayWindows: 'resources/tray-windows.ico',
+  updateOrigin: 'https://download.deepseek.com',
+  updateChannel: 'nightly',
+  brandEn: 'DeepSeek Harness',
+  brandZh: 'DeepSeek Harness',
+} as const
+
+export type DesktopBrandField = keyof typeof UPSTREAM_DESKTOP_BRAND
+
+export interface DesktopBrand extends Record<DesktopBrandField, string> {
+  readonly source: 'default' | 'file'
+  readonly file: string | undefined
+}
+
+const BRAND_FIELDS = Object.keys(UPSTREAM_DESKTOP_BRAND) as DesktopBrandField[]
+
+/**
+ * Resolve product-owned storage independently of shell DSH_HOME.
+ * @param brand - validated product identity from the existing branding configuration.
+ * @param home - operating-system home of this launch.
+ * @returns private Harness and Electron roots, or undefined for the upstream identity.
+ */
+export function resolveBrandedDesktopStorage(brand: Pick<DesktopBrand, 'appId'>, home = homedir()): {
+  readonly dshHome: string
+  readonly userData: string
+} | undefined {
+  if (brand.appId === UPSTREAM_DESKTOP_BRAND.appId) return undefined
+  const dshHome = join(home, '.dsh-products', brand.appId)
+  return { dshHome, userData: join(dshHome, 'desktop-user-data') }
+}
+
+/** Locate an explicit branding file. Absence is the upstream default, not an error. */
+export function resolveDesktopBrandingPath(env: NodeJS.ProcessEnv = process.env, appRoot = DESKTOP_APP_ROOT): string | undefined {
+  const fromEnv = env.DSH_DESKTOP_BRANDING
+  if (fromEnv !== undefined && fromEnv !== '') return resolve(fromEnv)
+  const local = join(appRoot, 'branding.json')
+  if (existsSync(local)) return local
+  const resources = env.DSH_DESKTOP_RESOURCES || process.resourcesPath
+  if (resources !== undefined && resources !== '' && existsSync(join(resources, 'branding.json'))) return join(resources, 'branding.json')
+  return undefined
+}
+
+/** Accept an HTTPS update base. A path is allowed; credentials, query, and fragment are not. */
+export function desktopBrandUpdateBase(value: string, name = 'updateOrigin'): string {
+  let parsed: URL
+  try {
+    parsed = new URL(value)
+  }
+  catch {
+    throw new Error(`desktop branding: ${name} must be an absolute HTTPS URL`)
+  }
+  if (parsed.protocol !== 'https:' || parsed.username !== '' || parsed.password !== '' || parsed.search !== '' || parsed.hash !== '') {
+    throw new Error(`desktop branding: ${name} must be HTTPS without credentials, query, or fragment`)
+  }
+  return `${parsed.origin}${parsed.pathname.replace(/\/$/u, '')}`
+}
+
+/** Load the product overlay. No file means every field stays at the upstream value. */
+export function loadDesktopBrand(env: NodeJS.ProcessEnv = process.env, appRoot = DESKTOP_APP_ROOT): DesktopBrand {
+  const path = resolveDesktopBrandingPath(env, appRoot)
+  if (path === undefined) return { ...UPSTREAM_DESKTOP_BRAND, source: 'default', file: undefined }
+  let raw: unknown
+  try {
+    raw = JSON.parse(readFileSync(path, 'utf8'))
+  }
+  catch {
+    throw new Error(`desktop branding: cannot read ${path}`)
+  }
+  if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('desktop branding: config must be an object')
+  const record = raw as Record<string, unknown>
+  const brand: Record<DesktopBrandField, string> = { ...UPSTREAM_DESKTOP_BRAND }
+  for (const field of BRAND_FIELDS) {
+    if (record[field] === undefined) continue
+    if (typeof record[field] !== 'string' || record[field].trim() === '') throw new Error(`desktop branding: ${field} must be a non-empty string`)
+    brand[field] = record[field].trim()
+  }
+  if (!/^[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+$/u.test(brand.appId)) throw new Error('desktop branding: appId must be a reverse-DNS identifier')
+  if (!/^[a-z][a-z0-9+.-]{1,31}$/u.test(brand.protocol)) throw new Error('desktop branding: protocol must be a lowercase scheme')
+  if (!/^[a-z0-9][a-z0-9-]{0,30}$/u.test(brand.updateChannel)) throw new Error('desktop branding: updateChannel must be a lowercase channel name')
+  brand.updateOrigin = desktopBrandUpdateBase(brand.updateOrigin)
+  const resources = env.DSH_DESKTOP_RESOURCES || process.resourcesPath
+  const packaged = resources !== undefined && resources !== '' && path === join(resources, 'branding.json')
+  for (const field of ['iconMac', 'iconWindows', 'trayWindows'] as const) {
+    const icon = isAbsolute(brand[field]) ? brand[field] : join(appRoot, brand[field])
+    if (packaged) continue
+    if (!existsSync(icon)) throw new Error(`desktop branding: ${field} does not exist: ${icon}`)
+    brand[field] = icon
+  }
+  return { ...brand, source: 'file', file: path }
+}
+
+/** Replace the upstream product name in one dictionary. Model-provider wording is left alone. */
+export function applyDesktopBrandMessages<T extends Record<string, string>>(messages: T, brand: Pick<DesktopBrand, 'brandEn' | 'brandZh'>, locale: 'en' | 'zh-CN'): T {
+  const replacement = locale === 'zh-CN' ? brand.brandZh : brand.brandEn
+  if (replacement === 'DeepSeek Harness') return messages
+  return Object.fromEntries(Object.entries(messages).map(([key, value]) => [key, value.replaceAll('DeepSeek Harness', replacement)])) as T
+}
